#!/usr/bin/env bash
set -euo pipefail

expected_sha=$1
kind=$2
for attempt in $(seq 1 30); do
  sha=$(curl -fsS --max-time 10 -A 'Mozilla/5.0' -H 'Cache-Control: no-cache' \
    https://teknoskor.com/deployment.json \
    | node -e 'const fs = require("node:fs"); process.stdout.write(JSON.parse(fs.readFileSync(0)).commit || "")' || true)
  if [[ "$sha" == "$expected_sha" ]]; then
    if [[ "$kind" == monitor ]]; then
      curl -fsS --max-time 20 -A 'Mozilla/5.0' -H 'Cache-Control: no-cache' \
        https://teknoskor.com/monitorler -o "$RUNNER_TEMP/monitor-catalog.html"
      test "$(grep -o 'data-monitor-model=' "$RUNNER_TEMP/monitor-catalog.html" | wc -l)" -gt 0
      read -r slug gtin < <(node -e '
        const models = require("./site/frontend/src/data/monitorPilot.json").models;
        const observed = model => Math.max(0, ...model.offers.map(offer => Date.parse(offer.observed_at) || 0));
        const latest = [...models].sort((a, b) => observed(b) - observed(a))[0];
        if (!latest || !/^[a-z0-9-]+$/.test(latest.slug) || !/^[0-9]{13}$/.test(latest.gtin)) process.exit(1);
        console.log(latest.slug + " " + latest.gtin);
      ')
      curl -fsS --max-time 20 -A 'Mozilla/5.0' -H 'Cache-Control: no-cache' \
        "https://teknoskor.com/monitorler/$slug" -o "$RUNNER_TEMP/monitor-detail.html"
      grep -Fq "$gtin" "$RUNNER_TEMP/monitor-detail.html"
    fi
    echo "Production is serving $expected_sha."
    exit 0
  fi
  sleep 20
done
echo 'Production did not serve the published commit in time.' >&2
exit 1
